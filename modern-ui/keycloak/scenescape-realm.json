{
  "realm": "scenescape",
  "enabled": true,
  "displayName": "SceneScape",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "roles": {
    "realm": [
      { "name": "scenescape-viewer", "description": "Read SceneScape operational data" },
      { "name": "scenescape-admin", "description": "Administer SceneScape resources" }
    ]
  },
  "clients": [
    {
      "clientId": "scenescape-ui",
      "name": "SceneScape modern UI",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8088/*", "http://127.0.0.1:8088/*"],
      "webOrigins": ["http://localhost:8088", "http://127.0.0.1:8088"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8088/*##http://127.0.0.1:8088/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "roles", "profile", "email"]
    }
  ]
}
